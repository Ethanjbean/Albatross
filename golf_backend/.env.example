# Copy to .env and fill in. Never commit .env itself (it's gitignored).

# --- Database: use EITHER DATABASE_URL (hosted) OR the DB_* vars (local) ---
# DATABASE_URL=postgres://user:password@host:5432/golf_backend
DB_HOST=localhost
DB_PORT=5432
DB_NAME=golf_backend
DB_USER=postgres
DB_PASSWORD=
# true if your host requires SSL (most hosted Postgres does)
DB_SSL=false

# Tests use this database (must end in _test; tests wipe it)
TEST_DB_NAME=golf_backend_test

# --- Auth ---
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- ryzegolf via RapidAPI ---
RYZE_URL=
RAPIDAPI_KEY=
RYZE_HOST=

# --- Server (optional) ---
# PORT is set by your host automatically; 3000 locally
# PORT=3000
# Comma-separated origins allowed to call the API; unset = any
# CORS_ORIGIN=https://your-app.onrender.com

# Course lookup rate limits (optional)
# LOOKUP_LIMIT_PER_USER=20
# LOOKUP_LIMIT_GLOBAL_DAILY=500
